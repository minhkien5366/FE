# ==========================================
# 1. BIẾN MÔI TRƯỜNG DÀNH CHO LOCAL (MÁY TÍNH)
# ==========================================
# Link Backend (Khi chạy ở máy tính thì nó trỏ về localhost:8080 của Spring Boot)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Link web hiện tại (Khi chạy ở máy thì là 3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# 2. CẤU HÌNH NEXT AUTH (ĐĂNG NHẬP)
# ==========================================
# Mật khẩu để mã hóa session (Ông lên web chạy lệnh 'openssl rand -base64 32' lấy 1 mã dán vào đây)
AUTH_SECRET=chuoi-ma-hoa-bi-mat-cua-ong-dien-vao-day

# Link xử lý Auth (Ở máy tính thì để 3000)
AUTH_URL=http://localhost:3000/api/auth